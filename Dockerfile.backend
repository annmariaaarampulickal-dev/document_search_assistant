# Use official Python image
FROM python:3.11-slim
 
# Set working directory inside container
WORKDIR /app
 
# Copy requirements first (for Docker layer caching)
COPY requirements.txt .
 
# 1. First install CPU-only PyTorch and ML libraries cleanly
RUN pip install --no-cache-dir torch==2.12.0+cpu transformers==5.9.0 sentence-transformers==5.5.1 --extra-index-url https://download.pytorch.org/whl/cpu

# 2. Install remaining core dependencies
RUN pip install --no-cache-dir -r requirements.txt
 
# Download NLTK punkt tokenizer
RUN python -m nltk.downloader punkt punkt_tab
 
# Copy all project files
COPY main.py .
COPY database.py .
COPY utils.py .
COPY .env .
 
# Expose FastAPI port
EXPOSE 8000
 
# Start FastAPI
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]